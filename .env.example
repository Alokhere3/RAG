# ==============================================================================
# RAG Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for deployment or local execution:
#   cp .env.example .env
#
# NEVER commit real credentials or production secrets to version control.
# In production, set APP_ENV=production, DEBUG=false, and specify real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Runtime Environment
# ------------------------------------------------------------------------------
# APP_ENV: Runtime environment [development | testing | staging | production]
# Production enforces: DEBUG=false, non-wildcard CORS, PostgreSQL, 32+ char JWT_SECRET
APP_ENV=development

# APP_NAME: Public application title
APP_NAME="RAG Platform"

# APP_VERSION: Application release version string
APP_VERSION=0.1.0

# DEBUG: Debugging mode [true | false] - MUST be false in production
DEBUG=true

# API_V1_PREFIX: URL namespace prefix for v1 API endpoints
API_V1_PREFIX=/api/v1

# Network binding and host port mappings
# Note: Host ports 3001 and 8001 prevent collision with external host services on 3000/8000
PORT=8001
BACKEND_PORT=8001
FRONTEND_PORT=3001
HOST=0.0.0.0

# CORS_ORIGINS: Comma-separated list of allowed origins. Wildcard * forbidden in production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ------------------------------------------------------------------------------
# 2. White-Label Organization Identity
# ------------------------------------------------------------------------------
# ORGANIZATION_NAME: Client organization or company display name
ORGANIZATION_NAME="Demo Organization"

# ORGANIZATION_LOGO_URL: Absolute path (/) or full URL (http://, https://) to brand logo
ORGANIZATION_LOGO_URL=

# ORGANIZATION_WEBSITE_URL: Client corporate website link
ORGANIZATION_WEBSITE_URL=

# Legacy alias (backward compatibility)
LOGO_URL=

# ------------------------------------------------------------------------------
# 3. Virtual Assistant Persona
# ------------------------------------------------------------------------------
# ASSISTANT_NAME: Identity of the AI virtual assistant companion
ASSISTANT_NAME="AI Assistant"

# ASSISTANT_DESCRIPTION: User-facing persona purpose tagline
ASSISTANT_DESCRIPTION="Ask questions about your organization's knowledge."

# ASSISTANT_AVATAR_URL: Image URL for assistant avatar badge
ASSISTANT_AVATAR_URL=

# Legacy alias (backward compatibility)
BOT_NAME="AI Assistant"

# ------------------------------------------------------------------------------
# 4. Visual Theme & Design Tokens
# ------------------------------------------------------------------------------
# Colors must strictly match #RGB or #RRGGBB hexadecimal format
# PRIMARY_COLOR: Main accent for action buttons and highlights
PRIMARY_COLOR=#2563EB

# SECONDARY_COLOR: Surface contrast and card headings
SECONDARY_COLOR=#1E293B

# ACCENT_COLOR: Tags, badges, and focus rings
ACCENT_COLOR=#3B82F6

# FAVICON_URL: Custom browser tab icon URL
FAVICON_URL=

# ------------------------------------------------------------------------------
# 5. Feature Flags (Frontend UI Gating)
# ------------------------------------------------------------------------------
# ENABLE_CHAT: Toggle chat module interface visibility [true | false]
ENABLE_CHAT=false

# ENABLE_DOCUMENTS: Toggle document management interface visibility [true | false]
ENABLE_DOCUMENTS=false

# ------------------------------------------------------------------------------
# 6. Database Configuration (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# For local run against host port: postgresql+asyncpg://rag:rag@localhost:5432/rag
# Inside Docker network:          postgresql+asyncpg://rag:rag@postgres:5432/rag
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 7. Redis Cache & Async Broker
# ------------------------------------------------------------------------------
# For local run:                  redis://localhost:6379/0
# Inside Docker network:          redis://redis:6379/0
# For authenticated Redis:        redis://:YourRedisPassword@redis:6379/0
REDIS_URL=redis://localhost:6379/0

# REDIS_PASSWORD: When set, Redis requires authentication. Must be non-empty in production
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 8. Security & Authentication (Server Only)
# ------------------------------------------------------------------------------
# JWT_SECRET: Minimum 32-character high-entropy secret. Mandatory in production
JWT_SECRET=replace-with-a-random-secret

# AUTH_COOKIE_SECURE: Set to true in production (auto-defaulted when APP_ENV=production)
AUTH_COOKIE_SECURE=false

# AUTH_COOKIE_SAMESITE: Cookie SameSite policy [lax | strict | none]
AUTH_COOKIE_SAMESITE=lax

# JWT_ALGORITHM: HMAC algorithm for JWT signing [HS256 | HS384 | HS512]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ------------------------------------------------------------------------------
# 9. LLM & Embeddings Configuration (Reserved for Future Phases)
# ------------------------------------------------------------------------------
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# ------------------------------------------------------------------------------
# 10. Database Migration Configuration (F-12B)
# ------------------------------------------------------------------------------
# RUN_MIGRATIONS_ON_STARTUP: Run Alembic migrations on container boot [true | false]
# Defaults to false. Set to true only in development for convenience.
# In production, run migrations via: docker compose run --rm backend alembic upgrade head
RUN_MIGRATIONS_ON_STARTUP=false

# MIGRATION_DATABASE_URL: Separate DDL-privileged connection for Alembic migrations.
# When empty, falls back to DATABASE_URL. In production, point to the rag_migrator role.
# Example: postgresql+asyncpg://rag_migrator:StrongMigratorPass@db:5432/rag
MIGRATION_DATABASE_URL=
